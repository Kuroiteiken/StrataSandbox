{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "Turkish",
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
    "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run serve)",
      "Bash(npm run bench)",
      "Bash(node --test *)",
      "Bash(node tools/*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(npm test)",
      "PowerShell(npm run serve)",
      "PowerShell(npm run bench)",
      "PowerShell(node --test *)",
      "PowerShell(node tools/*)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push)",
      "PowerShell(git push origin main)"
    ]
  }
}
